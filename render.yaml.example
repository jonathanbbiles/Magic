# Render Blueprint TEMPLATE for the Magic backend (2026-06-30).
#
# WHY: the realized-expectancy breaker, closed-trade stats and equity snapshots
# persist under DATASET_DIR. On Render the filesystem is EPHEMERAL unless a disk
# is mounted — without one, that history (and the breaker's window) is wiped on
# every redeploy. Declaring the disk here makes durability infrastructure-as-code.
#
# This file is named `render.yaml.example` on purpose: Render only auto-applies a
# file literally named `render.yaml`. REVIEW and match `name`, `plan`, `region`
# and env vars to your existing service, then rename to `render.yaml` and connect
# it as a Blueprint (or simply add a Disk mounted at /mnt/data to the existing
# service in the Render dashboard — that alone is sufficient).
services:
  - type: web
    name: magic-backend            # <-- match your existing Render service name
    runtime: node
    rootDir: backend
    plan: starter                  # a persistent disk requires a paid instance type
    region: oregon                 # <-- match your service region
    buildCommand: npm ci
    startCommand: npm start
    healthCheckPath: /health
    autoDeploy: true
    envVars:
      - key: DATASET_DIR
        value: /mnt/data
    disk:
      name: magic-data
      mountPath: /mnt/data
      sizeGB: 1
